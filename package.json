{
  "name": "cetus",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "console:dev": "pnpm --filter @cetus/console dev",
    "console:build": "pnpm --filter @cetus/console build",
    "console:check": "pnpm --filter @cetus/console check",
    "console:lint": "pnpm --filter @cetus/console lint",
    "console:format": "pnpm --filter @cetus/console format",
    "console:test": "pnpm --filter @cetus/console test",
    "docs:dev": "pnpm --filter @cetus/docs dev",
    "docs:build": "pnpm --filter @cetus/docs build",
    "docs:check": "pnpm --filter @cetus/docs check"
  },
  "devDependencies": {
    "railway": "3.16.0"
  },
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@1.3.0",
      "rollup": "4.64.9",
      "express@5>body-parser": "2.4.0",
      "undici@7": "7.30.1",
      "fast-uri@3": "3.1.9",
      "openapi-to-postmanv2>yaml": "1.10.3",
      "openapi-to-postmanv2>js-yaml": "4.3.2",
      "postman-collection>uuid": "11.1.1"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  }
}
