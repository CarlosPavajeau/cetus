{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Certificates",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET/certificates/*"
    },
    {
      "Sid": "PresignedDownloads",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKET/documents/*"
    },
    {
      "Sid": "SealSecrets",
      "Effect": "Allow",
      "Action": "kms:GenerateDataKey",
      "Resource": "arn:aws:kms:us-east-1:ACCOUNT_ID:key/KEY_ID"
    }
  ]
}
