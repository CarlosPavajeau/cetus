# Postgres user that only has privileges on the "auth" schema
DATABASE_URL=postgres://cetus_auth:cetus@localhost:5432/cetus
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the console; also the JWT issuer that Quarkus validates
BETTER_AUTH_URL=http://localhost:3000
# Cetus API, reached server-to-server (Railway private network in production)
CETUS_API_URL=http://localhost:8080
