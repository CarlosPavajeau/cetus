# Postgres user that only has privileges on the "auth" schema
DATABASE_URL=postgres://cetus_auth:cetus@localhost:5432/cetus
# E2E tests only: the API's Postgres user, for the fixtures that write to the "billing" schema.
CETUS_TEST_BILLING_DATABASE_URL=postgres://cetus_billing:cetus@localhost:5432/cetus
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the console; also the JWT issuer that Quarkus validates
BETTER_AUTH_URL=http://localhost:3000
# Cetus API, reached server-to-server (Railway private network in production)
CETUS_API_URL=http://localhost:8080
# Account emails (invitations) through Resend: a send-only key, apart from the worker's. Without both,
# the email is written to the log, links included.
# RESEND_API_KEY=
# CETUS_AUTH_EMAIL_FROM="Cetus <cuentas@cetus.example.com>"
# Without Resend, account emails are also kept as JSON files here; the end-to-end tests read their links.
CETUS_EMAIL_OUTBOX_DIR=.email-outbox
# Errors and traces to Sentry; unset locally. The browser's DSN (VITE_SENTRY_DSN) is fixed at build time.
# SENTRY_DSN=
# The landing's WhatsApp number, international format without "+" (573001234567); without it, no button.
# CETUS_WHATSAPP_NUMBER=
# PostHog's project key (US cloud) for the landing and the sign-up, cookieless; without it, no analytics.
# CETUS_POSTHOG_KEY=
