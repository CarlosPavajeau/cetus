{
  "name": "@cetus/console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "start": "srvx serve --prod --entry dist/server/server.js --static ../client --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run && playwright test",
    "test:integration": "vp test run",
    "test:e2e": "playwright test",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "auth:generate": "auth generate --config src/lib/auth/server.ts --output src/lib/auth/schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "api:types": "openapi-typescript http://localhost:8080/q/openapi -o src/lib/api/schema.d.ts",
    "api:types:file": "openapi-typescript ../api/build/openapi/openapi.yaml -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "arktype": "2.2.8",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "^1.59.0",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-qr-code": "2.2.0",
    "shadcn": "^4.22.0",
    "srvx": "^1.0.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tanstack/react-query-devtools": "5.104.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.7.10",
    "drizzle-kit": "1.0.0-rc.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vite-tsconfig-paths": "6.1.1"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
