# Copy to apps/worker/.env (git-ignored); Quarkus dev mode reads it. In Railway, set these as service variables.
# Resend API key with "Sending access" only, one per environment. Never commit the real value.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Facturas <facturas@facturas.example.com>
CETUS_EMAIL_FROM=
# Mailbox that receives every TEST (habilitación) document instead of its customer. Empty: TEST is not emailed.
CETUS_EMAIL_TEST_RECIPIENT=
# false exports traces, metrics and logs to the local Grafana (mise run infra-otel).
CETUS_OTEL_DISABLED=true
# The same Wompi keys as the API (sandbox: pub_test_, prv_test_, test_integrity_, test_events_).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
