# Copy to apps/api/.env (git-ignored); Quarkus dev mode reads it. In Railway, set it as a service variable.
# Signing secret (whsec_...) of the Resend webhook that points to POST /internal/email-events.
RESEND_WEBHOOK_SECRET=
# false exports traces, metrics and logs to the local Grafana (mise run infra-otel).
CETUS_OTEL_DISABLED=true
# Wompi keys of one environment (Dashboard > Desarrolladores). Sandbox: pub_test_, prv_test_, test_integrity_,
# test_events_. Without all four no order can be placed.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Where Wompi sends the customer back after paying. Wompi's checkout refuses (CloudFront 403) a return address on
# localhost or 127.0.0.1, so local purchases need another host: http://cetus.localhost:3000 points at this
# machine without setup in Chrome and Firefox, but the console's session lives on localhost:3000.
# CETUS_CONSOLE_URL=http://cetus.localhost:3000
# Wompi's events do not reach this machine: the worker finds the payment within ~25 min on its own, or run
# `mise run tunnel` and set https://<tunnel>/internal/webhooks/wompi as the events URL in Wompi's sandbox.
# Without CETUS_TUNNEL it is a quick tunnel: a new URL every run that exposes the whole local API. For a fixed URL
# that only lets Wompi's events in (infra/cloudflared/dev.yml), once per developer:
#   cloudflared tunnel login            (choose the Cloudflare domain)
#   cloudflared tunnel create cetus-dev
#   cloudflared tunnel route dns cetus-dev cetus-dev.<domain>
# and put CETUS_TUNNEL = "cetus-dev" under [env] in mise.local.toml.
